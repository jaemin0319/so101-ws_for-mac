# so101-ws_for-mac 설정 — 모든 scripts/*.sh 가 scripts/activate.sh 를 통해 이 파일을 불러온다.
#
# 이 파일에는 PC와 무관한 기본값만 둔다. PC마다 다른 값(Hugging Face 사용자, 팔 포트, 카메라 번호)은
#   bash scripts/setup_local.sh
# 가 자동으로 찾아 config/so101.local.env 에 쓴다(Git 에 올라가지 않음). 그 파일이 아래 값을 덮어쓴다.
# 이 파일을 고친 뒤에는 새 터미널을 열거나 `source scripts/activate.sh` 를 다시 실행한다.
# 토큰·비밀번호는 넣지 않는다(Hugging Face 로그인은 `bash scripts/hub.sh login`).

# ---- conda 환경 ----
SO101_ENV_NAME=so-arm_ws

# ---- Hugging Face ----
# 데이터셋/모델 repo_id 앞부분. 비워 두면 로그인한 계정(`hf auth whoami`)을 쓴다. setup_local.sh 가 채운다.
HF_USER=

# ---- 로봇 팔 (SO-101: Feetech STS3215 x6, USB 시리얼 보드) ----
# macOS: /dev/cu.usbmodem<보드 시리얼>  (보드 시리얼이 이름에 들어 있어 USB 구멍이 바뀌어도 같다)
# Linux: /dev/serial/by-id/usb-..._<보드 시리얼>-if00
# setup_local.sh 가 모터 전압(follower 12V 전원, leader 5V 전원)을 읽어 어느 쪽인지 자동으로 구분한다.
SO101_ROBOT_TYPE=so101_follower
SO101_TELEOP_TYPE=so101_leader
SO101_FOLLOWER_PORT=
SO101_LEADER_PORT=
# ID = 보정 파일 이름: calibration/robots/so_follower/<ID>.json, calibration/teleoperators/so_leader/<ID>.json
SO101_FOLLOWER_ID=so101_follower
SO101_LEADER_ID=so101_leader

# ---- 카메라 (front: 작업면을 내려다보는 외부 카메라, wrist: 그리퍼 위 카메라) ----
# macOS: OpenCV(AVFoundation) 카메라 번호(0, 1, ...). 재연결·재부팅 뒤 바뀔 수 있다.
#        python scripts/cameras.py snap --all 로 번호별 사진을 찍어 보고 setup_local.sh --front N --wrist M 으로 정한다.
# Linux: /dev/v4l/by-path/...-video-index0 (USB 포트 위치 기준)
SO101_CAM_FRONT=
SO101_CAM_WRIST=
SO101_CAM_WIDTH=640
SO101_CAM_HEIGHT=480
SO101_CAM_FPS=30
# 회전: 0, 90, 180, -90. front 카메라를 거꾸로 달았으면 180(학습 데이터와 같아야 한다).
SO101_CAM_FRONT_ROTATION=180
SO101_CAM_WRIST_ROTATION=0
# macOS: AVFoundation 은 fourcc 지정을 지원하지 않아 비워 둔다.
# Linux: 카메라 2대가 USB 2.0 허브를 같이 쓰면 MJPG 가 필요하다(YUYV 는 프레임이 깨짐) → MJPG
SO101_CAM_FOURCC=

# ---- 작업 공간 안 저장 위치 (SO101_WS 는 activate.sh 가 정한다) ----
# LeRobot 데이터셋 루트: 녹화한 데이터셋은 data/<HF_USER>/<name>, 허브에서 받은 것은 data/hub/ 에 생긴다.
HF_LEROBOT_HOME=$SO101_WS/data
# LeRobot 보정 파일 위치
HF_LEROBOT_CALIBRATION=$SO101_WS/calibration
# 허브에서 받은 모델: models/<name>
SO101_MODEL_DIR=$SO101_WS/models
# 학습 결과: outputs/train/<job_name>
SO101_OUTPUT_DIR=$SO101_WS/outputs

# ---- 녹화 기본값 (scripts/record.sh 옵션으로 덮어쓸 수 있다) ----
SO101_RECORD_FPS=30
SO101_RECORD_EPISODE_TIME_S=30
SO101_RECORD_RESET_TIME_S=10

# ---- 학습 기본값 (scripts/train.sh 옵션으로 덮어쓸 수 있다) ----
# ACT batch 8: NVIDIA 8GB GPU 기준 값. Apple Silicon(MPS)은 학습이 느리다(M4 Air 약 1.35 s/step) → 긴 학습은 GPU PC 권장.
SO101_TRAIN_POLICY=act
SO101_TRAIN_STEPS=100000
SO101_TRAIN_BATCH_SIZE=8
SO101_TRAIN_SAVE_FREQ=20000
