# macOS arm64(Apple Silicon) 전용 고정값. scripts/install_macos.sh와 scripts/so101.py가 KEY=VALUE로 파싱한다(source하지 않음).
# 공통값(LEROBOT_*, UV_VERSION, PYTHON_MINOR)은 lock/lerobot.env에서 읽는다.
# 값을 바꾸면 `scripts/install_macos.sh --relock`으로 lock/macos-arm64/uv.lock을 다시 만들고 검증해야 한다.

# uv 고정 바이너리(GitHub 릴리스 자산 + 공식 .sha256 파일로 검증, 2026-10-09 확인).
# 아카이브 구조: uv-aarch64-apple-darwin/{uv,uvx}
UV_ASSET=uv-aarch64-apple-darwin.tar.gz
UV_SHA256=50487ae565ccd96e499056b4674d438f4c53170202617b4c759defe0c6a1b544

# uv managed CPython(python-build-standalone). uv 0.12.23이 아는 최신 3.12 패치(2026-10-09 `uv python list 3.12 --only-downloads`).
# 작업공간 .tools/python에만 설치한다(--no-bin). 다운로드 무결성은 uv에 내장된 sha256으로 검증된다.
PYTHON_VERSION=3.12.15

# 설치기가 요구하는 최소 macOS(opencv-python-headless·av 휠 태그 macosx_13_0_arm64 기준).
MACOS_MIN=13.0

# 이 lock이 설치하는 lerobot extras(doctor가 확인).
LEROBOT_EXTRAS=feetech,dataset
